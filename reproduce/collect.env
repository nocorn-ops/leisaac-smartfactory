# ═══════════════════════════════════════════════════════════════════════════════
# 数采会话配置（`bash reproduce/collect.sh` 会自动读这个文件）
#
# 用法：
#   1) 在这里把参数改好（每个 key 都能被命令行覆盖，例如 --episodes 10）
#   2) 跑：bash reproduce/collect.sh
#
# 说明：
#   · 脚本会**自己起仿真**（如果没在跑），按下面的参数摆好机器人，然后按"定时分集"走完
#     EPISODES 条：每条录 EPISODE_TIME 秒 → 自动保存 → 停 RESET_TIME 秒 → 下一条。
#   · 录制期间的操作：真主手 / 双臂键盘（在仿真窗口里按键），和平时一样。
#   · 终端热键（在 collect.sh 那个终端里按）：
#        →（右箭头）提前结束当前阶段（录制中=立刻保存这条；重置中=立刻开始下一条）
#        ←（左箭头）丢弃当前这条并重录
#        q          结束会话（已完成的那几条都已保存）
# ═══════════════════════════════════════════════════════════════════════════════

# ── 会话 ───────────────────────────────────────────────────────────────────────
EPISODES=30                     # 录多少条
EPISODE_TIME=60                 # 每条录多少秒（到点自动保存）
RESET_TIME=20                   # 每条之间停多少秒（摆好下一轮的初始状态）

# ── 任务与数据集 ───────────────────────────────────────────────────────────────
TASK=LeIsaac-SmartFactory-v0    # 换厨房：LeIsaac-LeRobot-Kitchen-v0
DATASET=datasets/sf_pick_eggplant.hdf5   # 输出 HDF5（必须是不存在的文件；建议就放 datasets/ 下）
TASK_DESC="把茄子放进收纳盒"     # 一句话描述，转换/训练时会用到（同一个模型所有数据用同一句）

# ── 起仿真的参数（脚本会拼成 reproduce/ros2_chassis_teleop.sh 的命令行）────────
START_AT=shelf                  # 作业位：shelf 收纳架前 / transfer 转运架前 / home 起点区 / 空=场景初始位姿
TELEOP_DEVICE=                  # 留空 = 自动探测（两条主手在→双臂主手；否则 bi-keyboard）
LEFT_ARM_PORT=                  # 真主手串口；留空用默认 /dev/ttyACM0
RIGHT_ARM_PORT=                 # 留空用默认 /dev/ttyACM1
LIDAR_STOP=0                    # 激光前向急停距离（0=关；**别设 0.45** —— 在柜子前净空只有 0.38m，
                                #   开了会把"想往前/往后微调"也挡住。要防穿墙设 0.25~0.3 并自己试）
EXTRA_SIM_ARGS=""               # 需要的话再加别的仿真参数，例如 "--no_hud"

# ── 别动这些（除非你知道在干什么）─────────────────────────────────────────────
BRIDGE_PORT=5560                # 桥接端口
SIM_LOG=reproduce/out/collect_sim.log   # 仿真的日志
STOP_SIM_AT_END=1               # 1 = 会话结束后把脚本起的仿真也关掉；0 = 留着
