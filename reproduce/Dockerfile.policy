# LeIsaac 推理策略容器 —— 独立的 lerobot 0.4.2 Python 3.11 环境
# （与 Isaac Sim 容器分离：lerobot 0.4.2 的依赖与 Isaac Sim 冲突）
#
# 构建:  docker build -f reproduce/Dockerfile.policy -t leisaac-policy:lerobot0.4.2 reproduce/
FROM python:3.11-slim

# 版本与 PROJECT_README.md / CLAUDE.md 记录完全一致：
#   lerobot==0.4.2   draccus==0.10.0(必须)  datasets>=4.0,<4.2  huggingface-hub<0.36
RUN pip install --no-cache-dir \
        "lerobot==0.4.2" \
        "draccus==0.10.0" \
        "datasets>=4.0.0,<4.2.0" \
        "huggingface-hub<0.36.0"

WORKDIR /workspace
