    float physics:mass = 0.35

    def Cube "Bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </StorageBox/Bottom/Looks/M>
        bool physics:collisionEnabled = 1
        double size = 1
        float3 xformOp:scale = (0.3, 0.2, 0.008)
        double3 xformOp:translate = (0, 0, -0.076)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        def "Looks"
        {
            def Material "M"
            {
                token outputs:surface.connect = </StorageBox/Bottom/Looks/M/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.6
                    token outputs:surface
                }
            }
        }
    }

