        double radius = 0.015600000000000001
        double3 xformOp:translate = (-0.09192533317427735, -0.04286548683761528, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "Looks"
        {
            def Material "M"
            {
                token outputs:surface.connect = </Banana/Seg0/Looks/M/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.93, 0.82, 0.22)
